rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(field) {
      return isSignedIn() && request.auth.uid == resource.data[field];
    }

    function isOwnerWrite(field) {
      return isSignedIn() && request.auth.uid == request.resource.data[field];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role in ['admin', 'superadmin'];
    }

    function isPublishedProperty() {
      return resource.data.published == true || resource.data.status == "published";
    }

    // ── Public / homepage ──────────────────────────────────────────────────

    match /popular_cities/{cityId} {
      allow read: if true;
    }

    match /cities/{cityId} {
      allow read: if true;
    }

    // ── View events ────────────────────────────────────────────────────────

    match /view_events/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(["property_id", "created_at"]);
    }

    // ── Users / profiles ───────────────────────────────────────────────────

    match /users/{userId} {
      allow get:    if (isSignedIn() && request.auth.uid == userId)
                    || resource.data.role == "agent";
      allow list:   if resource.data.role == "agent";
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ── Properties ─────────────────────────────────────────────────────────

    match /properties/{propertyId} {
      allow get:    if isPublishedProperty() || isOwner("agent_id") || isAdmin();
      allow list:   if isPublishedProperty() || isOwner("agent_id") || isAdmin();
      allow create: if isOwnerWrite("agent_id") || isAdmin();
      allow update: if isOwner("agent_id") || isAdmin();
      allow delete: if isOwner("agent_id") || isAdmin();
    }

    // ── Reviews ────────────────────────────────────────────────────────────

    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isOwnerWrite("author_uid");
      allow update, delete: if isOwner("author_uid");
    }

    match /agent_reviews/{reviewId} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner("author_id");
    }

    // ── Boost / campaigns ──────────────────────────────────────────────────

    match /boost_requests/{boostId} {
      // Active boosts are displayed on the public homepage — readable without auth
      allow read:   if resource.data.status == "active" || isOwner("agent_id") || isAdmin();
      allow list:   if true;   // homepage queries with where("status","==","active")
      allow create: if isOwnerWrite("agent_id");
      allow update: if isOwner("agent_id") || isAdmin();
      allow delete: if isOwner("agent_id") || isAdmin();
    }

    match /promotion_requests/{reqId} {
      allow read:   if isSignedIn();
      allow create: if isOwnerWrite("agent_id");
      allow update, delete: if isOwner("agent_id") || isAdmin();
    }

    // ── Subscriptions ──────────────────────────────────────────────────────

    match /subscriptions/{subId} {
      allow read:   if isSignedIn() && (request.auth.uid == resource.data.user_id || isAdmin());
      allow write:  if isAdmin();
    }

    // ── Saved searches ─────────────────────────────────────────────────────

    match /saved_searches/{searchId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create:      if isOwnerWrite("userId");
    }

    // ── Notifications ──────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read, write: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // ── Team members — agents & admins only ───────────────────────────────

    match /team_members/{memberId} {
      allow read:  if isSignedIn() && (
                     request.auth.token.role in ['agent', 'admin', 'superadmin']
                   );
      allow write: if isAdmin();
    }

    // ── Reports ────────────────────────────────────────────────────────────

    match /reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // ── Webhook logs (admin only) ───────────────────────────────────────────

    match /webhook_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ── Analytics aggregation (read-only for clients) ──────────────────────

    match /property_like_agg/{propertyId} {
      allow read:  if true;
      allow write: if false;
    }

    match /like_events/{eventId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // ── Favourites ─────────────────────────────────────────────────────────

    match /user_favorites/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Conversations & messages — participants only ───────────────────────

    match /conversations/{convId} {
      allow read, write: if isSignedIn() && (
                           request.auth.uid in resource.data.participant_ids
                           || isAdmin()
                         );
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participant_ids;
    }

    match /messages/{msgId} {
      allow read:   if isSignedIn() && (
                      request.auth.uid == resource.data.sender_id
                      || request.auth.uid == resource.data.recipient_id
                      || isAdmin()
                    );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sender_id;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sender_id;
    }

    // ── Default: deny everything not explicitly matched ────────────────────
    // IMPORTANT: deny-by-default prevents accidental exposure of new collections.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
