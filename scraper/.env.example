# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A: path to service account JSON (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option B: inline JSON string (recommended for CI/cloud)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Firebase project details (must match your .env values)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# ── Scraper settings ──────────────────────────────────────────────────────────
# Firestore agent_id stamped on every scraped listing
SCRAPER_AGENT_ID=scraper_bot

# How many new listings to save per run
SCRAPER_DAILY_TARGET=10

# Publish immediately ("published") or queue for review ("draft")
SCRAPER_DEFAULT_STATUS=published

# Daily run time in 24-h format (HH:MM), local server time
SCRAPER_RUN_TIME=07:00

# Comma-separated list of Kenyan cities to prioritise
SCRAPER_TARGET_CITIES=Nairobi,Mombasa,Kisumu,Nakuru,Kiambu

# Seconds to wait between HTTP requests (be polite)
SCRAPER_REQUEST_DELAY=2
