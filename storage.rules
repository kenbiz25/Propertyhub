rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Property images: owner can write, public can read (listings are public)
    match /properties/{userId}/{propertyId}/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Scraper bot uploads (Admin SDK bypasses these rules, but kept for reference)
    match /properties/scraper_bot/{propertyId}/{fileName} {
      allow read:  if true;
      allow write: if false;   // only writable via Admin SDK (server-side)
    }

    // User profile avatars — owner writes, authenticated users read
    match /users/{userId}/avatar/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // KYC documents — owner writes, only admins read
    match /kyc/{userId}/{allPaths=**} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId
                       || request.auth.token.role in ['admin', 'superadmin']);
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
